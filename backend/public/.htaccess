<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Laravel routes (api, admin panel, livewire, storage, login, logout)
    RewriteRule ^(api|admin|livewire|storage|login|logout|filament)(/|$) index.php [L]

    # Existing files/folders → serve directly (assets, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → React SPA
    RewriteRule ^ index.html [L]
</IfModule>
